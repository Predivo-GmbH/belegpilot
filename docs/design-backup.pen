                  "type": "text",
                  "id": "leVF2",
                  "name": "r2b",
                  "fill": "#505967",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• Stock photos with fake smiles or poses\n• Overly saturated or heavily filtered images\n• Busy, cluttered backgrounds\n• Generic corporate stock imagery\n• Photos with visible competitor branding\n• Low-resolution or pixelated images\n• Illustrations that clash with the clean UI style",
                  "lineHeight": 1.8,
                  "fontFamily": "Plus Jakarta Sans",
                  "fontSize": 13,
                  "fontWeight": "normal"
