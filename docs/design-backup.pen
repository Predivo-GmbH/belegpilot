        {
          "type": "text",
          "id": "234Tk",
          "name": "Title",
          "fill": "#1A1D23",
          "content": "Voice & Tone",
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 40,
          "fontWeight": "700",
          "letterSpacing": -0.5
        },
        {
          "type": "rectangle",
          "id": "fT1ww",
          "name": "AccentBar",
          "fill": "#0E7C6B",
          "width": 40,
          "height": 4
        },
        {
          "type": "text",
          "id": "HgOYb",
          "name": "Body",
          "fill": "#505967",
          "textGrowth": "fixed-width",
          "width": 700,
          "content": "BelegPilot communicates in German (Swiss audience). Our voice is professional, clear, and confident — like a trusted financial advisor who respects your time. We avoid jargon, stay concise, and always put the user's task first.",
          "lineHeight": 1.7,
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "1ZANX",
          "name": "Columns",
          "width": "fill_container",
          "gap": 24,
          "children": [
            {
              "type": "frame",
              "id": "K2Cgz",
              "name": "Principles",
              "width": "fill_container",
              "fill": "#F0F7F5",
              "cornerRadius": 8,
              "layout": "vertical",
              "gap": 16,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "Wjv3S",
                  "name": "c1h",
                  "fill": "#1A1D23",
                  "content": "Brand Voice Attributes",
                  "fontFamily": "Plus Jakarta Sans",
                  "fontSize": 16,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "k1bp4",
                  "name": "c1b",
                  "fill": "#505967",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Professionell\nClear, authoritative, trustworthy. We speak with the confidence of a financial expert.\n\nPräzise\nEvery word earns its place. No filler, no marketing fluff. Data speaks louder than adjectives.\n\nHilfsbereit\nWe guide without patronizing. Short sentences, active voice, actionable instructions.\n\nSchweizerdeutsch-freundlich\nFormal German (Sie) in the UI, but warm and approachable. No stiff bureaucratic language.",
                  "lineHeight": 1.6,
                  "fontFamily": "Plus Jakarta Sans",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "o40X0",
              "name": "Examples",
              "width": "fill_container",
              "fill": "#F0F7F5",
              "cornerRadius": 8,
              "layout": "vertical",
              "gap": 16,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "KwQ44",
                  "name": "c2h",
                  "fill": "#1A1D23",
                  "content": "UI Copy Examples",
                  "fontFamily": "Plus Jakarta Sans",
                  "fontSize": 16,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "j11IT",
                  "name": "c2b",
                  "fill": "#505967",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "✓  «3 Belege erfolgreich verarbeitet»\n✕  «Ihre Dokumente wurden erfolgreich hochgeladen und verarbeitet!»\n\n✓  «Beleg hochladen»\n✕  «Klicken Sie hier, um Ihre Dokumente hochzuladen»\n\n✓  «Überprüfung erforderlich»\n✕  «Achtung! Dieses Feld muss überprüft werden!»\n\n✓  «CHF 1'247.50»\n✕  «CHF 1,247.50» oder «Fr. 1247.50»\n\n✓  «Keine Belege gefunden»\n✕  «Es wurden leider keine Ergebnisse gefunden»",
                  "lineHeight": 1.8,
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "m8Chw",
          "name": "Formatting",
          "width": "fill_container",
          "fill": "#E6F5F2",
          "cornerRadius": 8,
          "gap": 12,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "m7zkP",
              "name": "ficon",
              "content": "🇨🇭",
              "fontFamily": "Plus Jakarta Sans",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "N3FeO",
              "name": "ftxt",
              "fill": "#1A1D23",
              "textGrowth": "fixed-width",
              "width": 900,
              "content": "Swiss formatting: Use apostrophe as thousands separator (1'000), Swiss franc (CHF), formal Sie, dates as DD.MM.YYYY, times as HH:MM.",
              "fontFamily": "Plus Jakarta Sans",
              "fontSize": 13,
              "fontWeight": "500"
            }
          ]
        }
      ]
    },
