          "fontFamily": "JetBrains Mono",
          "fontSize": 11,
          "fontWeight": "500",
          "letterSpacing": 0.55
        },
        {
          "type": "text",
          "id": "a0jvR",
          "name": "miTitle",
          "fill": "#1A1D23",
          "content": "Incorrect Usage",
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 40,
          "fontWeight": "700",
          "letterSpacing": -0.5
        },
        {
          "type": "rectangle",
          "id": "aPKkd",
          "name": "miBar",
          "fill": "#0E7C6B",
          "width": 40,
          "height": 4
        },
        {
          "type": "text",
          "id": "0E3vl",
          "name": "miBody",
          "fill": "#505967",
          "textGrowth": "fixed-width",
          "width": 700,
          "content": "To maintain brand integrity, never modify the BelegPilot logo. The following are examples of incorrect usage:",
          "lineHeight": 1.7,
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "eU82c",
          "name": "miList",
          "fill": "#DF1B41",
          "textGrowth": "fixed-width",
          "width": 600,
          "content": "✕  Do not stretch or distort the logo\n✕  Do not change the logo colors\n✕  Do not rotate the logo\n✕  Do not add effects (shadows, gradients, outlines)\n✕  Do not place the logo on busy backgrounds\n✕  Do not rearrange logo elements\n✕  Do not use the logo smaller than minimum size\n✕  Do not crop or partially hide the logo",
          "lineHeight": 2,
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
