          "height": 4
        },
        {
          "type": "text",
          "id": "hy1Kt",
          "name": "introBody",
          "fill": "$ink-body",
          "textGrowth": "fixed-width",
          "width": 700,
          "content": "BelegPilot transforms how Swiss Treuhand firms process financial documents. Using advanced AI, we extract, verify, and structure data from invoices, receipts, and contracts — replacing hours of manual data entry with seconds of automated precision.\n\nOur brand embodies three core principles: Precision in every detail, Efficiency in every workflow, and Trust in every interaction. These values guide every design decision, from the confidence indicators on extracted fields to the clean, professional interface that finance professionals expect.",
          "lineHeight": 1.7,
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 16,
          "fontWeight": "normal"
        },
