              "width": 900,
              "content": "Swiss formatting: Use apostrophe as thousands separator (1'000), Swiss franc (CHF), formal Sie, dates as DD.MM.YYYY, times as HH:MM.",
              "fontFamily": "Plus Jakarta Sans",
              "fontSize": 13,
              "fontWeight": "500"
            }
