          "fill": "$ink-body",
          "textGrowth": "fixed-width",
          "width": 600,
          "content": "Maintain a minimum clear space equal to the height of the 'B' lettermark around all sides of the logo. This ensures the logo maintains visual impact and is never crowded by surrounding elements.\n\nMinimum sizes:\n• Mark only: 16px (digital), 8mm (print)\n• Horizontal lockup: 120px wide (digital), 30mm (print)\n• Vertical lockup: 80px wide (digital), 20mm (print)",
          "lineHeight": 1.7,
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 14,
          "fontWeight": "normal"
